# =============================================================================
# Olist E-Commerce Dispute Resolution Multi-Agent System - Environment Config
# =============================================================================

# Groq API Key (Required for LLM reasoning via Llama 3.1 8B)
# Get your free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# LLM Model Selection (Must be <= 10B parameters for lab compliance)
# Default: llama-3.1-8b-instant (8B parameters)
GROQ_MODEL=llama-3.1-8b-instant

# LLM Sampling Temperature (Default: 0.0 for deterministic reasoning)
LLM_TEMPERATURE=0.0

# Path Configurations (Optional, defaults to relative workspace folders)
INPUT_DIR=input
OUTPUT_DIR=output
DATA_DIR=data
LOG_DIR=logging
